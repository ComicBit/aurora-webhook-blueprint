# Rust 0.2.1: serve/doctor load .env beside the selected config.
# Or use global --env-file PATH; explicit missing fails. Process env wins.
# Other commands and the Python synthetic sender do NOT load this file.
# Reference placeholders only. With user approval capture real values in an
# ignored owned regular single-link 0600 .env outside shared/synced folders.
# No symlinks or untrusted-writer ancestors; max 64 KiB. Never shell-source.
# Protect clipboard/editor backups/OS/backups; restart receiver after edits.
# Aurora Signing secret: Generate only if missing, then Copy from the app.
# Do NOT replace the app key with receiver `keygen` (synthetic tooling only).
AURORA_WEBHOOK_SECRET=whsec_REPLACE_WITH_COPIED_AURORA_KEY
# Distinct bearer: `target/release/aurora-webhook token-gen` has sensitive output.
# CSPRNG 32-byte URL-safe unpadded base64; paste ONLY this into app Auth > Bearer.
AURORA_BEARER_TOKEN=REPLACE_WITH_GENERATED_BEARER

# Optional adapters only. Config stores these VARIABLE NAMES, not secret values.
# No AURORA_* variable may be referenced as an adapter credential/endpoint.
# Claude new_task/continue credential_env maps this to ANTHROPIC_API_KEY under --bare:
# MEETING_CLAUDE_API_KEY=REPLACE_WITH_APPROVED_API_KEY
# Claude cloud_followup instead maps its explicit credential_env to CLAUDE_CODE_OAUTH_TOKEN:
# MEETING_CLAUDE_OAUTH_TOKEN=REPLACE_WITH_APPROVED_OAUTH_TOKEN

# Hermes custom local CLI provider: base_url_env references the reviewed URL.
# Model/provider are explicit config fields, not environment-selected defaults.
# MEETING_HERMES_BASE_URL=http://127.0.0.1:8000/v1
# Codex/Hermes authentication belongs in their dedicated private profile,
# not an ambient environment credential forwarded by the receiver.

# Hermes official Runs API; URL must name /v1/runs exactly:
# MEETING_HERMES_RUNS_URL=https://your-approved-private-host.example/v1/runs
# MEETING_HERMES_RUNS_BEARER=REPLACE_WITH_APPROVED_BEARER
# Grok Bot: exact privately provisioned existing-routine webhook, not model API:
# MEETING_GROK_ROUTINE_URL=https://your-approved-routine-webhook.example/REPLACE
# MEETING_GROK_ROUTINE_BEARER=REPLACE_WITH_APPROVED_BEARER
