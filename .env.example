# Reference only: the receiver does NOT automatically load dotenv files.
# Provision these through a protected service environment. Never commit real values.
# Same signing key as Aurora, base64 of exactly 32 bytes:
AURORA_WEBHOOK_SECRET=whsec_REPLACE_WITH_BASE64_32_BYTES
# Optional; set only when matching Aurora bearer authentication:
# AURORA_BEARER_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Only for explicitly approved Hermes inference. No implicit provider/model default.
# See docs/agents.md; use your dedicated Hermes account/profile.
# HERMES_INFERENCE_MODEL=YOUR_APPROVED_MODEL
# HERMES_INFERENCE_PROVIDER=YOUR_APPROVED_PROVIDER
# CUSTOM_BASE_URL=https://your-approved-model-endpoint.example/v1
